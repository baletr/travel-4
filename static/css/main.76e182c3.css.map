@import url('https://fonts.googleapis.com/css2?family=Alice&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap');

.main {
    height: 100vh;
    width: 100%;
    background-color: #ededed;
    display: flex;
    justify-content: center;
    align-items: center;
}

.container { 
    box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;
    position: relative;
    background-color: white;
    height: 80%;
    width: 70%;
    border-radius: 15px;
}

.wrapper {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    width: 100%;
    padding: 35px;
}

.profile__item {
    display: flex;
    height: auto;
}

.data__item {
    height: auto;
    display: flex;
    flex-direction: column;
}

.data__text {
    border-bottom: 1px solid #EAEAEA;
}

.data__text__error {
    border-bottom: 1px solid red;
}

.error__message {
    color: red;
    margin-top: 5px;
}

.profile__img {
    height: 100%;
}

.profile__img img {
    width: 200px;
}

.profile__about {
    width: 100%;
    padding-left: 3%;
}

.profile__name {
    color: #2f2e41;
    font-family: 'Poppins', sans-serif;
    font-size: 48px;
    line-height: 56px;
    font-weight: 500;

    word-wrap: break-word;
}

.title {
    word-wrap: break-word;
    color: #2f2e41;
    font-family: 'Poppins', sans-serif;
    font-size: 35px;
    line-height: 52px;
    font-weight: 500;
    border: 0;
    width: 100%;
}


.subtitle {
    word-wrap: break-word;
    color: #6f6f6f;
    font-family: 'Poppins', sans-serif;
    font-size: 23px;
    line-height: 38px;
    font-weight: 300;
}

.profile__add {
    height: auto
}

.profile__load button {
    border-radius: 10px;
    border: none;
    width: 38%;
    padding: 2% 0;
    color: white;
    font-family: 'Poppins', sans-serif;
    font-size: 28px;
    font-weight: 400;
    background-color: #67a1d6;
    transition: all 0.1s ease-in;
    cursor: pointer;
}

.profile__load button:hover {
    transform: scale(1.03);
    cursor: pointer;
}
.profile__save_btn:disabled {
    cursor: not-allowed;
}


.profile__plus {
    flex-direction: column;
    border-radius: 15px;
    color: white;
    display: flex;
    justify-content: center !important;
    align-items: center;
    height: 52px;
    width: 52px;
    background-color: #67a1d6;
    font-size: 38px;

    transition: all 0.1s ease-in;
}

.profile__plus:hover {
    cursor: pointer;
    transform: scale(1.040);
}

.profile__title {
    font-family: 'Poppins', sans-serif;
    font-size: 26px;
    font-weight: 400;
    margin-left: 1.2%;
    color: #2f2e41;
}

.profile__file {
    padding-top: 2.5%;
    cursor: pointer;
    display: flex;
    align-items: center;
}

.profile__file input {
    display: none;
}

.profile__load {
    padding-top: 3%;
}

.ordering {
    width: 100%;
    display: flex;
    justify-content: space-around
}

.booked_btn {
    border: none;
    padding: 2% 15%;
    background-color: #67a1d6;
    color: white;
    font-size: 28px;
    border-radius: 10px;
    font-family: 'Poppins', sans-serif;
    transition: all 0.1s ease-in;
}

.booked_btn:hover {
    cursor: pointer;
    transform: scale(1.020);
}


.booked_btn:focus {
    box-shadow: rgba(0, 0, 0, 0.35) 0px 5px 15px;
}

.modal {
    height: auto !important;
    width: 650px !important;

}

.modal__wrapper {
    height: 550px;
    width: 100%;
    overflow-y: scroll;
}

.modal>div {
    width: 100%;
    height: 100%;
}

.modal__inner {
    padding: 10px;
    padding-bottom: 40px;
    display: flex;
    flex-direction: column;
}

.modal__item {
    display: flex;
    justify-content: space-between;
    width: 100%;
    padding-top: 8px;
    padding-bottom: 6px;
    border-bottom: 1px solid #ccc;
}

.modal__title {
    font-family: 'Poppins', sans-serif;
    color: #2f2e41;
    font-size: 22px;
    line-height: 38px;

}

.modal__descrip {
    text-align: center;
    font-family: 'Poppins', sans-serif;
    color: #2f2e41;
    font-size: 28px;
    font-weight: 600;
    line-height: 48px;
}

.modal__subtitle {
    font-family: 'Poppins', sans-serif;
    color: #2f2e41;
    font-size: 21px;
    font-weight: 600;
    line-height: 38px;

}

.modal__empty {
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 34px;
    font-family: 'Poppins', sans-serif;
    color: #2f2e41;
    font-weight: 600;
    text-align: center;
}

.modal__loader {
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
}

.modal__spin {
    width: 52px;
    height: 52px;
}

.save__btn {
    width: 17%;
    margin-top: 0.5em;
}

.cancel__btn {
    width: 17%;
    margin-top: 0.5em;
    margin-left: 1em;
}

.profile__change {
    width: auto;
}

.change__btn {
    font-family: 'Poppins', sans-serif;
    color: #2f2e41;
    font-weight: 400;
    background-color: #67a1d6;
    border: none;
    font-size: 18px;
    color: white;
    padding: 4% 8%;
    cursor: pointer;
    border-radius: 10px;
}

@media screen and (max-width:1500px) {
    .wrapper {
        padding: 25px;
    }

    .profile__title {
        font-size: 22px;
    }

    .profile__plus {
        height: 45px;
        width: 45px;
        font-size: 32px;
    }

    .profile__load button {
        font-size: 24px;
    }

    .profile__load {
        padding-top: 4%;
    }

    .profile__name {
        font-size: 46px;

    }

    .title {
        font-size: 30px;
    }

    .subtitle {
        font-size: 20px;
    }
}

@media screen and (max-width:1300px) {
    .wrapper {
        padding: 20px;
    }

    .profile__title {
        font-size: 20px;
    }

    .profile__plus {
        height: 42px;
        width: 42px;
        font-size: 30px;
    }

    .profile__load button {
        font-size: 24px;
    }

    .profile__name {
        font-size: 40px;
    }

    .title {
        font-size: 27px;
    }

    .container {
        height: 85%;
        width: 80%;
    }

    .modal {
        width: 550px !important;
    }

    .modal__wrapper {
        height: 450px;
    }

    .modal__title {
        font-size: 18px;
    }

    .modal__descrip {
        font-size: 24px;
    }

    .modal__subtitle {
        font-size: 17px;
    }

    .modal__empty {
        font-size: 28px;
    }

}

@media screen and (max-width:1050px) {
    .container {
        height: 85%;
        width: 80%;
    }

    .profile__about {
        width: 100%;
        padding-left: 3%;
    }

    .booked_btn {
        padding: 2% 8%;
        font-size: 22px;
    }

    .profile__change {
        width: auto;
    }

    .change__btn {
        font-size: 15px;
        color: white;
        padding: 3.5% 6%;
        cursor: pointer;
        border-radius: 10px;
    }
}

@media screen and (max-width:880px) {
    .profile__load button {
        width: 80%;
    }

    .save__btn,
    .cancel__btn {
        width: 25% !important;
    }

}

@media screen and (max-width:620px) {
    .container {
        height: 70%;
        width: 90%;
    }

    .profile__about {
        padding-left: 2%;
    }

    .wrapper {
        padding: 10px;
    }

    .profile__title {
        font-size: 17px;
    }

    .profile__plus {
        height: 36px;
        width: 36px;
        font-size: 28px;
    }

    .profile__load button {
        font-size: 19px;
    }

    .profile__load {
        padding-top: 8%;
    }

    .profile__name {
        line-height: 42px;
        font-size: 32px;

    }

    .title {
        font-size: 20px;
        line-height: 32px;
    }

    .subtitle {
        line-height: 24px;
        font-size: 16px;
    }

    .profile__img {
        width: 40%;
    }

    .profile__img img {
        height: 148px;
        width: 148px;
    }

    .profile__item {
        justify-content: space-between;
        height: 30%;
    }

    .ordering {
        width: 100%;
        display: flex;
        justify-content: flex-start;
        flex-direction: column;
    }

    .booked_btn {
        margin-top: 2%;
        padding: 2% 0%;
        width: 100%;
        font-size: 22px;

    }

    .modal {
        width: 450px !important;
    }

    .modal__wrapper {
        height: 400px;
    }

    .modal__title {
        font-size: 16px;
    }

    .modal__descrip {
        font-size: 21px;
    }

    .modal__subtitle {
        font-size: 16px;
    }

    .modal__empty {
        text-align: center;
        font-size: 20px;
    }

    .save__btn,
    .cancel__btn {
        width: 30% !important;
    }
}

@media screen and (max-width:450px) {
    .profile__img {
        display: flex;
        justify-content: center;
    }

    .container {
        height: 95%;
        width: 95%;
    }

    .profile__about {
        padding-left: 0%;
    }

    .profile__file {
        padding-top: 3%;
    }

    .wrapper {
        padding: 10px;
    }

    .profile__title {
        font-size: 17px;
    }

    .profile__plus {
        height: 36px;
        width: 36px;
        font-size: 28px;
    }

    .profile__load button {
        font-size: 17px;
    }

    .profile__load {
        padding-top: 3%;
    }

    .profile__name {
        font-size: 30px;

    }

    .title {
        font-size: 16px;
    }

    .subtitle {
        font-size: 12px;
    }

    .profile__img {
        width: 100%;
    }

    .profile__img img {
        height: 128px;
        width: 128px;
    }

    .profile__item {

        align-items: flex-start;
        justify-content: space-between;
        flex-direction: column;
        height: auto;
    }

    .wrapper {
        justify-content: space-between;
    }

    .booked_btn {
        font-size: 16px;

    }

    .modal {
        width: 450px !important;
    }

    .modal__wrapper {
        height: 400px;
    }

    .modal__title {
        font-size: 14px;
    }

    .modal__descrip {
        font-size: 19px;
    }

    .modal__subtitle {
        font-size: 14px;
    }

    .profile__change {
        width: 100%;
        padding-top: 2.5%;

    }

    .change__btn {
        font-size: 15px;
        color: white;
        padding: 1.5% 0%;
        width: 100%;
    }

    .profile__load button {
        width: 100%;
    }

    .save__btn,
    .cancel__btn {
        width: 40% !important;
    }
}

@media screen and (max-height:650px) {
    .profile__img img {
        height: 118px;
        width: 118px;
    }

    .main {
        height: 120vh;
    }
}

@media screen and (max-height:710px) {
    .container {
        height: 95%;
        width: 95%;
    }
}

@media screen and (max-height:520px) {
    .main {
        height: 125vh;
    }

    .booked_btn {
        width: 100%;
        font-size: 16px;
    }

    .profile__img img {
        height: 140px;
        width: 140px;
    }

    .profile__name {
        line-height: 34px;
        font-size: 29px;
    }

    .profile__file,
    .profile__load {
        padding-top: 1.8%;
    }

    .profile__load button {
        font-size: 16px;
    }

    .subtitle {
        margin-top: 1.5%;
        line-height: 28px;
        font-size: 14px;
    }

    .title {
        line-height: 24px;
        font-size: 16px;
    }
}

@media screen and (max-height:420px) {
    .booked_btn {
        width: 100%;
        font-size: 14px;
    }

    .main {
        height: 130vh;
    }

    .profile__img img {
        height: 120px;
        width: 120px;
    }

    .profile__name {
        line-height: 28px;
        font-size: 24px;
    }

    .profile__file,
    .profile__load {
        padding-top: 1.3%;
    }

    .profile__load button {
        font-size: 14px;
    }

    .subtitle {
        margin-top: 1.5%;
        line-height: 24px;
        font-size: 14px;
    }

    .title {
        line-height: 21px;
        font-size: 16px;
    }

    .profile__plus {
        height: 32px;
        width: 32px;
        font-size: 20px;
    }

    .profile__title {
        font-size: 16px;
    }
}

@media screen and (max-width:450px) and (min-height:715px) {
    .container {
        height: 90%;
        width: 95%;
    }
}

@media screen and (max-width:450px) and (min-height:815px) {
    .container {
        height: 85%;
        width: 90%;
    }


}